{
  "name": "music-kb-server",
  "version": "0.1.0",
  "private": true,
  "description": "Strapi backend for the music-kb app.",
  "scripts": {
    "build": "strapi build",
    "console": "strapi console",
    "deploy": "strapi deploy",
    "dev": "strapi develop",
    "develop": "strapi develop",
    "start": "strapi start",
    "strapi": "strapi",
    "export": "strapi export --no-encrypt --file ./seed-data/seed",
    "seed": "strapi import --file ./seed-data/seed.tar.gz",
    "db:dump:local": "mkdir -p exports && NODE_ENV=development strapi export --no-encrypt --file exports/local-$(date +%Y%m%d-%H%M%S)",
    "db:dump:neon": "mkdir -p exports && NODE_ENV=production strapi export --no-encrypt --file exports/neon-$(date +%Y%m%d-%H%M%S)",
    "db:load:local": "NODE_ENV=development strapi import --force --file",
    "db:load:neon": "NODE_ENV=production strapi import --force --file",
    "music-tags": "node scripts/seed-music-tags.mjs",
    "upgrade": "npx @strapi/upgrade latest",
    "upgrade:dry": "npx @strapi/upgrade latest --dry"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.26.0",
    "@strapi/plugin-cloud": "5.52.1",
    "@strapi/plugin-users-permissions": "5.52.1",
    "@strapi/strapi": "5.52.1",
    "better-sqlite3": "12.8.0",
    "pg": "^8.21.0",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "react-router-dom": "^6.0.0",
    "styled-components": "^6.0.0",
    "youtubei.js": "^17.0.1",
    "zod": "^4.3.5",
    "zod-to-json-schema": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=20.0.0 <=24.x.x",
    "npm": ">=6.0.0"
  },
  "strapi": {
    "uuid": false
  }
}
