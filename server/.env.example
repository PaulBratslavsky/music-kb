
# Server
HOST=0.0.0.0
PORT=1350

# Secrets
APP_KEYS=REPLACE_ME
API_TOKEN_SALT=REPLACE_ME
ADMIN_JWT_SECRET=REPLACE_ME
TRANSFER_TOKEN_SALT=REPLACE_ME
ENCRYPTION_KEY=REPLACE_ME

# Database
# --- Option A: central Neon Postgres (shared across machines / prod) ---
# Use the DIRECT (non-pooled) endpoint — drop "-pooler" from the Neon host,
# and drop "channel_binding=require". The pooler breaks Strapi boot migrations.
DATABASE_CLIENT=postgres
DATABASE_HOST=ep-xxxx.region.aws.neon.tech
DATABASE_PORT=5432
DATABASE_NAME=neondb
DATABASE_USERNAME=neondb_owner
DATABASE_PASSWORD=
DATABASE_SSL=true
DATABASE_SSL_REJECT_UNAUTHORIZED=true

# --- Option B: local SQLite (offline dev) ---
# DATABASE_CLIENT=sqlite
# DATABASE_FILENAME=.tmp/music-kb.db

JWT_SECRET=REPLACE_ME
